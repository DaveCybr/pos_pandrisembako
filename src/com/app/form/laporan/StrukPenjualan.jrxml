	<parameter name="id_penjualan" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    p.id_penjualan AS id_penjualan,
    p.tgl_penjualan AS tanggal_penjualan,
    pr.id_barang AS id_barang,
    b.nama_barang AS nama_barang,
    pr.qty AS jumlah_barang,
    pr.harga AS harga_per_unit,
    pr.nilai AS total_barang,
    p.bayar AS bayar,
    p.kembalian AS kembalian,
    p.nilai AS total_penjualan,
    (SELECT SUM(pr2.qty) 
     FROM tbl_penjualanrinci pr2 
     WHERE pr2.id_penjualan = p.id_penjualan) AS total_jumlah_barang
FROM 
    tbl_penjualan p
JOIN 
    tbl_penjualanrinci pr ON p.id_penjualan = pr.id_penjualan
JOIN 
    tbl_master_barang b ON pr.id_barang = b.id_barang
WHERE 
    p.id_penjualan = $P{id_penjualan};]]>
	</queryString>
	<field name="id_penjualan" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="tanggal_penjualan" class="java.sql.Date"/>
	<field name="id_barang" class="java.lang.String">

	</field>
	<field name="jumlah_barang" class="java.math.BigDecimal"/>
	<field name="harga_per_unit" class="java.math.BigDecimal"/>
	<field name="total_barang" class="java.math.BigDecimal"/>
	<field name="bayar" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="kembalian" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="total_penjualan" class="java.lang.Double"/>
	<field name="total_jumlah_barang" class="java.math.BigDecimal"/>
	<variable name="subtotal" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{total_barang}]]></variableExpression>
	</variable>
